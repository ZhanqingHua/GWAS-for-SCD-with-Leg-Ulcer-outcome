# 2. Define paths


GOOGLE_PROJECT_ID = "wb-rapid-grape-7347"

BUCKET = "gs://sicklecell-icd-wgs-wb-rapid-grape-7347"

MT_PATH = (
    "gs://vwb-aou-datasets-controlled/"
    "v9/wgs/short_read/snpindel/acaf_threshold/splitMT/hail.mt"
)

