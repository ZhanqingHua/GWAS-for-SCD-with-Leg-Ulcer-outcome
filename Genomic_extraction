    mt,
    ["chr15"],
    keep=True,
    reference_genome="GRCh38"
)

print("chr15 interval selected")



# 7. Restrict to your 665 participants


mt_subset = mt.semi_join_cols(sample_ht)

print("chr15 + 665-sample subset defined")


# 8. Recompute AC / AF / AN after sample filtering


mt_subset = recompute_call_stats(
    mt_subset
)

print("Call statistics recomputed")



# 9. Remove variants absent in your 665 participants


mt_subset = mt_subset.filter_rows(
    mt_subset.info.AC[1] > 0
)

print("AC=0 variants removed")



# 10. Write chr20 MatrixTable to your workspace bucket


print("Writing chr15 MatrixTable to:")
print(OUT_PATH)

mt_subset.write(
    OUT_PATH,
    overwrite=True
